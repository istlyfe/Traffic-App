# Copy to .env and fill in values from your Supabase project
# (Project Settings -> API). EXPO_PUBLIC_ variables are embedded in the
# app bundle -- they are safe to expose. NEVER put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only needed for release builds on Android (react-native-maps).
# Expo Go on Android ships its own key for development.
GOOGLE_MAPS_ANDROID_API_KEY=

# From `eas init` (optional until you build with EAS)
EAS_PROJECT_ID=
