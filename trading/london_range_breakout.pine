//@version=6
strategy("London Range Breakout (NQ/MNQ)", overlay=true,
     pyramiding=0, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.75, slippage=1,
     process_orders_on_close=false)

// Backtested on 5y of NQ 1m (2021-08 .. 2026-08): 48% win, ~1:1.27 realized R:R, +0.07R / trade, positive every year.

// ---------- Inputs ----------
londonSess = input.session("0300-0930", "London range session (ET)")
rthSess    = input.session("0930-1600", "RTH session used for ATR (ET)")
tradeSess  = input.session("0930-1130", "Entry window (ET)")
flatTime   = input.session("1555-1600", "Flatten window (ET)")
atrLen     = input.int(14,   "Daily range ATR length (RTH high-low)")
stopMult   = input.float(0.5, "Stop (x ATR)", step=0.05)
rrTarget   = input.float(2.0, "Target (R multiple)", step=0.25)
dailyLossUsd = input.float(400, "Daily loss limit $ (0 = off)")
tz         = "America/New_York"

inLondon = not na(time(timeframe.period, londonSess, tz))
inRth    = not na(time(timeframe.period, rthSess, tz))
inTrade  = not na(time(timeframe.period, tradeSess, tz))
inFlat   = not na(time(timeframe.period, flatTime, tz))
newDay   = timeframe.change("D")   // CME session rolls at 18:00 ET

// ---------- London range ----------
var float lonH = na
var float lonL = na
if newDay
    lonH := na
    lonL := na
if inLondon
    lonH := na(lonH) ? high : math.max(lonH, high)
    lonL := na(lonL) ? low  : math.min(lonL, low)

// ---------- ATR of RTH ranges (prior days) ----------
var float rthH = na
var float rthL = na
var array<float> ranges = array.new_float()
if newDay
    if not na(rthH)
        array.push(ranges, rthH - rthL)
        if array.size(ranges) > atrLen
            array.shift(ranges)
    rthH := na
    rthL := na
if inRth
    rthH := na(rthH) ? high : math.max(rthH, high)
    rthL := na(rthL) ? low  : math.min(rthL, low)
atr  = array.size(ranges) == atrLen ? array.avg(ranges) : na
risk = atr * stopMult

// ---------- One trade per day ----------
var bool tradedToday = false
var float dayStartEq = na
if newDay
    tradedToday := false
    dayStartEq  := strategy.equity
if strategy.position_size != 0
    tradedToday := true

dayLossHit = dailyLossUsd > 0 and not na(dayStartEq) and strategy.equity - dayStartEq <= -dailyLossUsd
canTrade = inTrade and not tradedToday and not dayLossHit and not na(risk) and not na(lonH) and strategy.position_size == 0

if canTrade
    if close < lonH
        strategy.entry("Long", strategy.long, stop=lonH)
    if close > lonL
        strategy.entry("Short", strategy.short, stop=lonL)
else
    strategy.cancel("Long")
    strategy.cancel("Short")

// ---------- Exits: stop = stopMult x ATR, target = rrTarget x stop ----------
if strategy.position_size > 0
    e = strategy.position_avg_price
    strategy.exit("L-exit", "Long", stop=e - risk, limit=e + rrTarget * risk)
    strategy.cancel("Short")
if strategy.position_size < 0
    e = strategy.position_avg_price
    strategy.exit("S-exit", "Short", stop=e + risk, limit=e - rrTarget * risk)
    strategy.cancel("Long")

if inFlat or dayLossHit
    strategy.close_all("Flat")

// ---------- Plots & alerts ----------
plot(inTrade or inLondon ? lonH : na, "London high", color=color.new(color.teal, 0), style=plot.style_linebr)
plot(inTrade or inLondon ? lonL : na, "London low",  color=color.new(color.orange, 0), style=plot.style_linebr)
bgcolor(inLondon ? color.new(color.gray, 92) : na, title="London session")
bgcolor(inTrade  ? color.new(color.blue, 92) : na, title="Entry window")
alertcondition(inTrade and ta.crossover(high, lonH), "London high break", "NQ broke London range high")
alertcondition(inTrade and ta.crossunder(low, lonL), "London low break",  "NQ broke London range low")
