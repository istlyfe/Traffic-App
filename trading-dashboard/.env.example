# Tradovate API credentials (Settings > API Access in Tradovate). Never commit the real .env.
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=TradingDashboard
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
TRADOVATE_DEVICE_ID=trading-dashboard-1
# "demo" for evals / sim-funded accounts, "live" for real-money accounts. Comma-separate to pull both.
TRADOVATE_ENVS=demo
PORT=3000
POLL_SECONDS=15
